#
# MT6789 (Helio G99) Xiaomi emerald GKI Kernel Fragment
# Based on Linux 6.12 GKI (Android 16/17)
#

# Architecture & CPU
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARM64_ERRATUM_1418040=y
CONFIG_ARM64_ERRATUM_1188873=y

# Device Tree & Clocks
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_OF_KOBJ=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_NET=y
CONFIG_OF_MDIO=y
CONFIG_OF_RESERVED_MEM=y
CONFIG_COMMON_CLK_MEDIATEK=y

# Power Management & Regulators
CONFIG_REGULATOR_MT6358=y
CONFIG_REGULATOR_MT6359=y
CONFIG_PM_DEVFREQ=y
CONFIG_ARM_MTK_CPUIDLE=y

# Thermal & LVTS
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_WRITABLE_TRIPS=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_MTK_THERMAL=y

# Interconnect & Bus
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_MEDIATEK=y

# Pin Control & GPIO
CONFIG_PINCTRL=y
CONFIG_PINCTRL_MTK=y
CONFIG_PINCTRL_MT6789=y

# I2C & SPI
CONFIG_I2C_MT65XX=y
CONFIG_SPI_MT65XX=y

# Input / Touchscreen / Fingerprint
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=m
CONFIG_TOUCHSCREEN_FTS=m

# USB & Charging
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_COMMON=y
CONFIG_USB_ARCH_HAS_HCD=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_POWER_SUPPLY=y

# Storage & EMMC / UFS
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_MEDIATEK=y

# Display & DRM
CONFIG_DRM=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_MEDIATEK=m

# Filesystems
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZ4=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
