	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			nu2115@slave {
				compatible = "nuvolta,nu2115-slave";
				reg = <0x6d>;
				status = "okay";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x0c 0x00>;
				nu2115,intr_gpio = <0xffffffff 0x0c 0x00>;
				charger_name = "secondary_dvchg";
				charger_name_v4_19 = "secondary_divider_chg";
				nuvolta,nu2115,bat-ovp-disable = <0x00>;
				nuvolta,nu2115,bat-ocp-disable = <0x01>;
				nuvolta,nu2115,bus-ocp-disable = <0x00>;
				nuvolta,nu2115,bat-ovp-threshold = <0x11df>;
				nuvolta,nu2115,bat-ocp-threshold = <0x1f40>;
				nuvolta,nu2115,bus-ovp-threshold = <0x300c>;
				nuvolta,nu2115,bus-ovp-alarm-threshold = <0x300c>;
				nuvolta,nu2115,bus-ocp-threshold = <0xea6>;
				nuvolta,nu2115,bus-ocp-alarm-threshold = <0xdac>;
				nuvolta,nu2115,ac-ovp-threshold = <0x32c8>;
				nuvolta,nu2115,sense-resistor-mohm = <0x05>;
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			clock-frequency = <0x61a80>;
			status = "okay";

			bq28z610@55 {
				compatible = "bq28z610";
				reg = <0x55>;
				enable_shutdown_delay;
				normal_shutdown_vbat_1s = <0xd48>;
				critical_shutdown_vbat_1s = <0xcee>;
				cool_critical_shutdown_vbat_1s = <0xcda>;
				old_critical_shutdown_vbat_1s = <0xce4>;
				report_full_rsoc_1s = <0x25b2>;
				soc_gap_1s = <0x02>;
				soc_decimal_rate = <0x00 0x26 0x0a 0x23 0x14 0x21 0x1e 0x21 0x28 0x21 0x32 0x21 0x3c 0x21 0x46 0x1e 0x50 0x19 0x5a 0x14 0x5f 0x0a>;
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";

			step_jeita {
				max_charger_voltage = <0xb71b00>;
				fv_offset_15_to_35 = <0x32>;
				fv_offset_35_to_48 = <0x3c>;
				iterm = <0xfa>;
				iterm_ffc_15_to_35 = <0x4e2>;
				iterm_ffc_35_to_48 = <0x546>;
				ffc_low_tbat = <0x96>;
				ffc_high_tbat = <0x1e0>;
				ffc_medium_tbat = <0x15e>;
				ffc_high_soc = <0x5f>;
				under_4200_curr_offset = <0x12c>;
				step_fallback_hyst = <0x19>;
				step_forward_hyst = <0x05>;
				jeita_fallback_hyst = <0x05>;
				jeita_forward_hyst = <0x05>;
				jeita_adaptor_over_temp_current = <0x3e8>;
				jeita_adaptor_temp_warning_current = <0x1a0a>;
				jeita_fcc_eu_cfg_limit_minutes = <0xffffff9c 0x00 0x2bc 0x01 0x32 0x960 0x33 0x64 0xd48 0x65 0x96 0x170c 0x97 0x15e 0x1a0a 0x15f 0x1e0 0x1a0a 0x1e1 0x244 0x960>;
				jeita_fcc_eu_cfg = <0xffffff9c 0x00 0x2bc 0x01 0x32 0x960 0x33 0x64 0xd48 0x65 0x96 0x170c 0x97 0x15e 0x2710 0x15f 0x1e0 0x2710 0x1e1 0x244 0x960>;
				jeita_fcc_cfg = <0xffffff9c 0x00 0x2bc 0x01 0x32 0x960 0x33 0x64 0xd48 0x65 0x96 0x170c 0x97 0x15e 0x189c 0x15f 0x1e0 0x189c 0x1e1 0x244 0x960>;
				jeita_fv_cfg = <0xffffff9c 0x00 0x1178 0x01 0x32 0x1180 0x33 0x64 0x1180 0x65 0x96 0x1180 0x97 0x15e 0x1180 0x15f 0x1e0 0x1176 0x1e1 0x244 0x1176>;
				step_chg_cfg_cycle = <0xe10 0x109a 0x3070 0x109b 0x10cc 0x2260 0x10cd 0x1180 0x1c84 0x1181 0x11b2 0x170c>;
				step_chg_normal_eu_cfg_cycle = <0xe10 0x109a 0x2710 0x109b 0x1180 0x1a0a>;
			};
		};
