/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;

			subpmic_core@61 {
				compatible = "southchip,subpmic_core";
				reg = <0x61>;
				status = "okay";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x04 0x00>;
				intr-gpio = <0xffffffff 0x04 0x00>;
				charger_name = "primary_chg";
				interrupt-controller;
				#interrupt-cells = <0x01>;

				subpmic_chg {
					compatible = "southchip,subpmic_chg";
					interrupts = <0x06 0x00 0x03 0x02>;
					interrupt-names = "Hourse Keeping", "Buck Charger", "DPDM", "LED";
					sc,vsys-limit = <0xdac>;
					sc,batsnc-enable = <0x00>;
					sc,vbat = <0x1162>;
					sc,charge-curr = <0x1f4>;
					sc,iindpm-disable = <0x00>;
					sc,input-curr-limit = <0x1f4>;
					sc,ico-enable = <0x00>;
					sc,iindpm-ico = <0x64>;
					sc,precharge-volt = <0x01>;
					sc,precharge-curr = <0x1f4>;
					sc,term-en = <0x01>;
					sc,term-curr = <0x1f4>;
					sc,rechg-dis = <0x00>;
					sc,rechg-dg = <0x00>;
					sc,rechg-volt = <0x00>;
					sc,boost-voltage = <0x1388>;
					sc,boost-max-current = <0x5dc>;
					sc,conv-ocp-dis = <0x00>;
					sc,tsbat-jeita-dis = <0x01>;
					sc,ibat-ocp-dis = <0x00>;
					sc,vpmid-ovp-otg-dis = <0x00>;
					sc,vbat-ovp-buck-dis = <0x00>;
					sc,ibat-ocp = <0x01>;
					status = "okay";
				};

				subpmic_ufcs {
					compatible = "southchip,subpmic_ufcs";
					interrupts = <0x05>;
					interrupt-names = "UFCS";
					subpmic_ufcs,name = "ufcs_port2";
					subpmic_ufcs,default-baudrate = <0x00>;
					subpmic_ufcs,default-request-volt = <0x1770>;
					subpmic_ufcs,default-request-curr = <0x7d0>;
				};

				subpmic_cid {
					compatible = "southchip,subpmic_cid";
					interrupts = <0x07>;
					interrupt-names = "CID";
					status = "okay";
				};
			};

			subpmic_core_nu@30 {
				compatible = "nuvolta,subpmic_core_nu";
				reg = <0x30>;
				status = "okay";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x04 0x00>;
				intr-gpio = <0xffffffff 0x04 0x00>;
				charger_name = "primary_chg";
				interrupt-controller;
				#interrupt-cells = <0x01>;

				chg {
					#io-channel-cells = <0x01>;
					status = "okay";
					compatible = "nuvolta,nu6601_charger";
					interrupts = <0x03 0x04 0x05 0x06 0x07 0x67 0x58 0x59 0x5a 0x5b 0x5c 0x5d 0x5e 0x5f 0x15 0x14 0x38 0x39 0x23 0x63 0x64>;
					interrupt-names = "usb_det_done", "vbus_0v", "vbus_gd", "chg_fsm", "chg_ok", "bc1p2_det_done", "dm_cot_pluse_done", "dp_cot_pluse_done", "dpdm_2pluse_done", "dpdm_3pluse_done", "dm_16pluse_done", "dp_16pluse_done", "hvdcp_det_fail", "hvdcp_det_ok", "boost_fail", "boost_gd", "led1_timeout", "led2_timeout", "vbat_ov", "dcd_timeout", "rid_cid_det";
					bootmode = <0xffffffff>;
					charger,enable-termination = <0x01>;
					charger,enable-ico = <0x00>;
					charger,batsns-en = <0x00>;
					charger,otg-vol = <0x1388>;
					charger,otg-current = <0x5dc>;
					charger,charge-voltage = <0x1130>;
					charger,charge-current = <0xbb8>;
					charger,precharge-current = <0xfa>;
					charger,term-current = <0xc8>;
					charger,input-curr-limit = <0xbb8>;
					charger,iindpm-disable = <0x00>;
					charger,rechg-dis = <0x00>;
					charger,rechg-volt = <0x00>;
					charger,cid-en = <0x01>;
					torch_max_level = <0x24>;
					strobe_max_level = <0x74>;
					strobe_timeout = <0x0b>;
					strobe_max_timeout = <0x17>;
					phandle = <0x46>;
				};
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;

			sc6601-pd@62 {
				compatible = "richtek,rt1711h";
				reg = <0x62>;
				status = "okay";
				sc-tcpc,name = "type_c_port0";
				sc-tcpc,role_def = <0x05>;
				sc-tcpc,rp_level = <0x01>;
				sc-tcpc,vconn_supply = <0x01>;
				sc-tcpc,notifier_supply_num = <0x02>;
				sc660x,intr_gpio_num = <0xffffffff 0x1a 0x00>;

				pd-data {
					pd,vid = <0x29cf>;
					pd,pid = <0x1711>;
					pd,source-cap-ext = [cf 29 11 17 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 02 00];
					pd,mfrs = "RichtekTCPC";
					pd,charging_policy = <0x31>;
					pd,source-pdo-size = <0x01>;
					pd,source-pdo-data = <0x19096>;
					pd,sink-pdo-size = <0x01>;
					pd,sink-pdo-data = <0x2d0c8>;
					pd,id-vdo-size = <0x06>;
					pd,id-vdo-data = <0xd54029cf 0x00 0x17110000 0x61000000 0x00 0x41000000>;
					bat,nr = <0x01>;
					pd,country_nr = <0x00>;

					bat-info0 {
						bat,vid = <0x29cf>;
						bat,pid = <0x1711>;
						bat,mfrs = "bat1";
						bat,design_cap = <0xbb8>;
					};
				};

				dpm_caps {
					local_dr_power;
					local_dr_data;
					local_usb_comm;
					local_no_suspend;
					local_vconn_supply;
					attempt_enter_dp_mode;
					attempt_discover_cable;
					attempt_discover_id;
					pr_check = <0x00>;
					dr_check = <0x00>;
				};

				displayport {
					1st_connection = "dfp_d";
					2nd_connection = "dfp_d";
					signal,dp_v13;
					typec,receptacle;

					ufp_d {
					};

					dfp_d {
						pin_assignment,mode_c;
						pin_assignment,mode_d;
						pin_assignment,mode_e;
					};
				};
			};

			sc660x-pd@63 {
				compatible = "southchip,sc660x";
				reg = <0x63>;
				status = "okay";
				sc-tcpc,name = "type_c_port0";
				sc-tcpc,role_def = <0x01>;
				sc-tcpc,rp_level = <0x01>;
				sc-tcpc,vconn_supply = <0x01>;
				sc-tcpc,notifier_supply_num = <0x02>;
				sc660x,intr_gpio_num = <0xffffffff 0x1a 0x00>;

				pd-data {
					pd,vid = <0x311c>;
					pd,pid = <0x6600>;
					pd,source-cap-ext = [1c 31 00 66 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 07 00];
					pd,sink-cap-ext = <0x1c310066 0x00 0x1000000 0x00 0x1000000 0x00>;
					pd,mfrs = "SouthChip";
					pd,charging_policy = <0x31>;
					pd,source-pdo-size = <0x01>;
					pd,source-pdo-data = <0x190c8>;
					pd,sink-pdo-size = <0x03>;
					pd,sink-pdo-data = <0x3601912c 0x3602d0c8 0xc0dc2464>;
					pd,id-vdo-size = <0x06>;
					pd,id-vdo-data = <0xd14029cf 0x00 0x17110000 0x61000000 0x00 0x41000000>;
					bat,nr = <0x01>;
					pd,country_nr = <0x00>;

					bat-info0 {
						bat,vid = <0x311c>;
						bat,pid = <0x6600>;
						bat,mfrs = "bat1";
						bat,design_cap = <0xbb8>;
					};
				};

				dpm_caps {
					local_dr_power;
					local_dr_data;
					local_usb_comm;
					local_no_suspend;
					local_vconn_supply;
					attempt_discover_cable;
					attempt_discover_id;
					attempt_discover_svid;
					pr_check = <0x00>;
					dr_check = <0x00>;
				};

				displayport {
					1st_connection = "dfp_d";
					2nd_connection = "dfp_d";
					signal,dp_v13;
					typec,receptacle;

					ufp_d {
					};

					dfp_d {
						pin_assignment,mode_c;
						pin_assignment,mode_d;
						pin_assignment,mode_e;
					};
				};
			};

			nu6601-pd@33 {
				compatible = "nuvolta,nu6601_typec_pd";
				reg = <0x33>;
				status = "okay";
				rt-tcpc,name = "type_c_port0";
				rt-tcpc,role_def = <0x01>;
				rt-tcpc,rp_level = <0x01>;
				rt-tcpc,vconn_supply = <0x01>;
				rt-tcpc,notifier_supply_num = <0x02>;
				rt1711pd,intr_gpio = <0xffffffff 0x1a 0x00>;
				rt1711pd,intr_gpio_num = <0x1a>;

				pd-data {
					pd,vid = <0x29cf>;
					pd,pid = <0x1711>;
					pd,source-cap-ext = [cf 29 11 17 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 02 00];
					pd,mfrs = "RichtekTCPC";
					pd,charging_policy = <0x31>;
					pd,source-pdo-size = <0x01>;
					pd,source-pdo-data = <0x19096>;
					pd,sink-pdo-size = <0x01>;
					pd,sink-pdo-data = <0x2d0c8>;
					pd,id-vdo-size = <0x06>;
					pd,id-vdo-data = <0xd54029cf 0x00 0x17110000 0x61000000 0x00 0x41000000>;
					bat,nr = <0x01>;
					pd,country_nr = <0x00>;

					bat-info0 {
						bat,vid = <0x29cf>;
						bat,pid = <0x1711>;
						bat,mfrs = "bat1";
						bat,design_cap = <0xbb8>;
					};
				};

				dpm_caps {
					local_dr_power;
					local_dr_data;
					local_usb_comm;
					local_no_suspend;
					local_vconn_supply;
					attempt_enter_dp_mode;
					attempt_discover_cable;
					attempt_discover_id;
					pr_check = <0x00>;
					dr_check = <0x00>;
				};

				displayport {
					1st_connection = "dfp_d";
					2nd_connection = "dfp_d";
					signal,dp_v13;
					typec,receptacle;

					ufp_d {
					};

					dfp_d {
						pin_assignment,mode_c;
						pin_assignment,mode_d;
						pin_assignment,mode_e;
					};
				};
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {

			sc8541@master {
				compatible = "sc,sc8541-master";
				reg = <0x6a>;
				interrupt-parent = <0xffffffff>;
				interrupts = <0x0b 0x00>;
				sc8541,intr_gpio = <0xffffffff 0x0b 0x00>;
				charger_name = "primary_dvchg";
				charger_name_v4_19 = "primary_divider_chg";
				sc,sc8541,vbat-ovp-dis = <0x00>;
				sc,sc8541,vbat-ovp = <0x5a>;
				sc,sc8541,vbat-ovp-alm-dis = <0x01>;
				sc,sc8541,vbat-ovp-alm = <0x46>;
				sc,sc8541,ibat-ocp-dis = <0x00>;
				sc,sc8541,ibat-ocp = <0x51>;
				sc,sc8541,ibat-ocp-alm-dis = <0x01>;
				sc,sc8541,ibat-ocp-alm = <0x50>;
				sc,sc8541,ibus-ucp-dis = <0x00>;
				sc,sc8541,vbus-in-range-dis = <0x00>;
				sc,sc8541,vbus-pd-en = <0x00>;
				sc,sc8541,vbus-ovp = <0x26>;
				sc,sc8541,vbus-ovp-alm-dis = <0x01>;
				sc,sc8541,vbus-ovp-alm = <0x22>;
				sc,sc8541,ibus-ocp-dis = <0x00>;
				sc,sc8541,ibus-ocp = <0x0d>;
				sc,sc8541,tshut-dis = <0x01>;
				sc,sc8541,tsbus-flt-dis = <0x01>;
				sc,sc8541,tsbat-flt-dis = <0x01>;
				sc,sc8541,tdie-alm = <0xc8>;
				sc,sc8541,tsbus-flt = <0x15>;
				sc,sc8541,tsbat-flt = <0x15>;
				sc,sc8541,vac1-ovp = <0x02>;
				sc,sc8541,vac2-ovp = <0x02>;
				sc,sc8541,vac1-pd-en = <0x00>;
				sc,sc8541,vac2-pd-en = <0x00>;
				sc,sc8541,fsw-set = <0x04>;
				sc,sc8541,wd-timeout = <0x00>;
				sc,sc8541,wd-timeout-dis = <0x01>;
				sc,sc8541,ibat-sns-r = <0x00>;
				sc,sc8541,ss-timeout = <0x07>;
				sc,sc8541,ibus-ucp-fall-dg = <0x01>;
				sc,sc8541,vout-ovp-dis = <0x00>;
				sc,sc8541,vout-ovp = <0x03>;
				sc,sc8541,pmid2out-uvp = <0x07>;
				sc,sc8541,pmid2out-ovp = <0x07>;
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {

			sc8541@slave {
				compatible = "sc,sc8541-slave";
				reg = <0x6a>;
				interrupt-parent = <0xffffffff>;
				interrupts = <0x0c 0x00>;
				sc8541,intr_gpio = <0xffffffff 0x0c 0x00>;
				charger_name = "secondary_dvchg";
				charger_name_v4_19 = "secondary_divider_chg";
				sc,sc8541,vbat-ovp-dis = <0x00>;
				sc,sc8541,vbat-ovp = <0x5a>;
				sc,sc8541,vbat-ovp-alm-dis = <0x01>;
				sc,sc8541,vbat-ovp-alm = <0x46>;
				sc,sc8541,ibat-ocp-dis = <0x00>;
				sc,sc8541,ibat-ocp = <0x51>;
				sc,sc8541,ibat-ocp-alm-dis = <0x01>;
				sc,sc8541,ibat-ocp-alm = <0x50>;
				sc,sc8541,ibus-ucp-dis = <0x00>;
				sc,sc8541,vbus-in-range-dis = <0x00>;
				sc,sc8541,vbus-pd-en = <0x00>;
				sc,sc8541,vbus-ovp = <0x26>;
				sc,sc8541,vbus-ovp-alm-dis = <0x01>;
				sc,sc8541,vbus-ovp-alm = <0x22>;
				sc,sc8541,ibus-ocp-dis = <0x00>;
				sc,sc8541,ibus-ocp = <0x0d>;
				sc,sc8541,tshut-dis = <0x01>;
				sc,sc8541,tsbus-flt-dis = <0x01>;
				sc,sc8541,tsbat-flt-dis = <0x01>;
				sc,sc8541,tdie-alm = <0xc8>;
				sc,sc8541,tsbus-flt = <0x15>;
				sc,sc8541,tsbat-flt = <0x15>;
				sc,sc8541,vac1-ovp = <0x02>;
				sc,sc8541,vac2-ovp = <0x02>;
				sc,sc8541,vac1-pd-en = <0x00>;
				sc,sc8541,vac2-pd-en = <0x00>;
				sc,sc8541,fsw-set = <0x04>;
				sc,sc8541,wd-timeout = <0x00>;
				sc,sc8541,wd-timeout-dis = <0x01>;
				sc,sc8541,ibat-sns-r = <0x00>;
				sc,sc8541,ss-timeout = <0x07>;
				sc,sc8541,ibus-ucp-fall-dg = <0x01>;
				sc,sc8541,vout-ovp-dis = <0x00>;
				sc,sc8541,vout-ovp = <0x03>;
				sc,sc8541,pmid2out-uvp = <0x07>;
				sc,sc8541,pmid2out-ovp = <0x07>;
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {

			nu2115@master {
				compatible = "nuvolta,nu2115-master";
				reg = <0x6d>;
				status = "okay";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x0b 0x00>;
				nu2115,intr_gpio = <0xffffffff 0x0b 0x00>;
				charger_name = "primary_dvchg";
				charger_name_v4_19 = "primary_divider_chg";
				nuvolta,nu2115,bat-ovp-disable = <0x00>;
				nuvolta,nu2115,bat-ocp-disable = <0x01>;
				nuvolta,nu2115,bus-ocp-disable = <0x00>;
				nuvolta,nu2115,bat-ovp-threshold = <0x11df>;
				nuvolta,nu2115,bat-ocp-threshold = <0x1f40>;
				nuvolta,nu2115,bus-ovp-threshold = <0x300c>;
				nuvolta,nu2115,bus-ovp-alarm-threshold = <0x300c>;
				nuvolta,nu2115,bus-ocp-threshold = <0xea6>;
				nuvolta,nu2115,bus-ocp-alarm-threshold = <0xdac>;
				nuvolta,nu2115,ac-ovp-threshold = <0x32c8>;
				nuvolta,nu2115,sense-resistor-mohm = <0x05>;
			};
		};
