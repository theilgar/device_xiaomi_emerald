cc_binary {
    name: "batterysecret",
    vendor: true,
    srcs: [
        "batterysecret.c",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
