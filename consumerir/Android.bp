cc_binary {
    name: "android.hardware.ir-service.emerald",
    relative_install_path: "hw",
    init_rc: ["android.hardware.ir-service.emerald.rc"],
    vintf_fragments: ["android.hardware.ir-service.emerald.xml"],
    vendor: true,
    srcs: [
        "ConsumerIr.cpp",
        "main.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "android.hardware.ir-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
